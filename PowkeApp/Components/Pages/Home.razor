@page "/"
@using Microsoft.AspNetCore.Components.QuickGrid
@using PowkeApp.Api
@inject HttpClient Http

<PageTitle>Pokemons</PageTitle>

@if (pokemons == null)
{
    <p>Loading...</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var pokemon in pokemons)
        {
            <div class="col">
                <div class="card h-100 text-center">
                    <img src="@pokemon.FrontDefault" class="card-img-top mx-auto mt-2" alt="@pokemon.Name" style="width: 200px;" />
                    <div class="card-body">
                        <h5 class="card-title text-capitalize">@pokemon.Name</h5>
                        <p class="card-text">
                            <small class="text-muted">
                                Poids : @pokemon.Weight | Taille : @pokemon.Height
                            </small>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PokemonDto>? pokemons;

    protected override async Task OnInitializedAsync()
    {
        pokemons = await Http.GetFromJsonAsync<List<PokemonDto>>("/api/pokemons");
    }
}